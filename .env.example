# ── Free AI (required for AI chat & explanations) ────────────────────────────
# Get a free key at: https://console.groq.com  (no credit card needed)
GROQ_API_KEY=

# Optional: https://huggingface.co/settings/tokens  (free tier, no key needed for basic use)
HUGGINGFACE_API_KEY=

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

# ── Database (auto-configured in Docker — change only for manual setup) ───────
DATABASE_URL=postgresql://clauseguard:clauseguard@localhost:5432/clauseguard
REDIS_URL=redis://localhost:6379/0

# ── File upload ───────────────────────────────────────────────────────────────
MAX_UPLOAD_MB=50
PROCESSING_STORAGE_PATH=./storage

# ── CORS (comma-separated origins) ───────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173

# ── NLP (leave blank for lightweight mode — recommended for local dev) ────────
# Set to en_core_web_sm for better quality: python -m spacy download en_core_web_sm
SPACY_MODEL=en_core_web_sm
# Leave blank to use fast keyword classifier (no GPU needed)
BERT_MODEL_NAME=

# ── Demo seed ─────────────────────────────────────────────────────────────────
ENABLE_DEMO_SEED=true

# ── Frontend ──────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_NAME=ClauseGuard

# ── Object storage (only needed if using MinIO/S3 — optional) ────────────────
AWS_ACCESS_KEY_ID=minio
AWS_SECRET_ACCESS_KEY=minio123
AWS_S3_BUCKET=clauseguard-docs
S3_ENDPOINT_URL=http://localhost:9000
